<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon (P11), API 26+. The launcher masks these two layers into
  whatever shape the device uses, so the heart lives in the inner 66% of the
  foreground and the background is a flat fill rather than a bitmap: one colour
  entry instead of five PNGs that could drift apart.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
