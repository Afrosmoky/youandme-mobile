# Release signing secrets (P12). Copy to android/keystore.properties — that copy
# is gitignored — and fill in the real passwords, or export the same names as
# environment variables (the environment wins over this file).
#
# Only the passwords are required. JAITY_RELEASE_STORE_FILE and
# JAITY_RELEASE_KEY_ALIAS default to jaity-release.keystore / jaity, so a plain
# local setup needs the store password alone when the key password matches it.

JAITY_RELEASE_STORE_PASSWORD=
JAITY_RELEASE_KEY_PASSWORD=

# JAITY_RELEASE_STORE_FILE=jaity-release.keystore
# JAITY_RELEASE_KEY_ALIAS=jaity
